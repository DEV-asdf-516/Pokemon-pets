{
  "name": "pokemon-pet",
  "version": "1.0.0",
  "description": "Pokemon desktop pet with LLM chat",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && npm run build:copy",
    "build:copy": "node -e \"const fs=require('fs'); fs.mkdirSync('build/renderer',{recursive:true}); ['index.html','styles.css'].forEach(f=>fs.copyFileSync('src/renderer/'+f,'build/renderer/'+f))\"",
    "start": "npm run build && electron .",
    "create:pet": "node scripts/create-pet.js",
    "validate:pet": "node scripts/validate-pet.js",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.pokemon.pet",
    "productName": "Pokemon Pet",
    "files": [
      "main.js",
      "build/**/*",
      "pets/**/*",
      "config/**/*",
      "!.env",
      "!.env.*",
      ".env.example"
    ],
    "publish": {
      "provider": "github"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  }
}
